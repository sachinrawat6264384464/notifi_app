# ==========================================
# BOTMARTZ AI - Render Production Environment
# ==========================================

# Application Settings
APP_ENV=production
SECRET_KEY=botmartz_production_secret_key_change_me_to_random_string_32_chars
API_V1_STR=/api/v1
PROJECT_NAME="Smart Personal Scheduler & Reminder API"

# Database Configuration (Neon Managed PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:npg_f5HqoLObEca2@ep-aged-pine-a5k7hfx1-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis & Celery Configuration (Render Managed Redis or Upstash)
# Example: rediss://default:password@xxxxxx.render.com:6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Firebase Admin SDK Configuration (Optional for Auth / Push Notifications)
FIREBASE_PROJECT_ID=botmartz-ai-scheduler
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@botmartz-ai-scheduler.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_REAL_FIREBASE_PRIVATE_KEY\n-----END PRIVATE KEY-----"
FIREBASE_CREDENTIALS_FILE=

# CORS Configuration (Allowed Domains / App Origins)
# Set to "*" or your specific app/web domain
CORS_ORIGINS=["*"]
