# Application Environment
APP_ENV=development
SECRET_KEY=change_this_to_a_secure_random_string_32_chars

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_scheduler
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/smart_scheduler

# Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Firebase Configuration
FIREBASE_PROJECT_ID=smart-scheduler-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@smart-scheduler-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"
FIREBASE_CREDENTIALS_FILE=

# CORS Configuration
CORS_ORIGINS=["*"]
